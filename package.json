{
  "name": "feat-forge",
  "version": "0.1.0",
  "description": "Feature-first CLI workflow tool",
  "license": "AGPL-3.0-only",
  "bin": {
    "forge": "dist/cli.js"
  },
  "main": "dist/cli.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && cp -r src/templates dist/",
    "start": "node dist/cli.js",
    "dev": "node dist/cli.js --help",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "commander": "^12.1.0",
    "execa": "^9.4.0",
    "inquirer": "^13.2.2"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.9",
    "@types/node": "^22.10.5",
    "prettier": "^3.8.1",
    "reflect-metadata": "^0.2.2",
    "typescript": "^5.6.3"
  }
}
