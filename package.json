{
  "name": "feat-forge",
  "version": "0.1.0",
  "description": "Feature-first CLI workflow tool",
  "license": "AGPL-3.0-only",
  "type": "module",
  "bin": {
    "forge": "dist/cli.js"
  },
  "main": "dist/cli.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm run build:clean && pnpm run build:transpile && pnpm run build:copy && pnpm run build:permissions",
    "build:clean": "rm -rf dist",
    "build:transpile": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "build:copy": "cp -r src/templates dist/",
    "build:permissions": "chmod +x dist/cli.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "commander": "^12.1.0",
    "execa": "^9.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "^4.0.18",
    "prettier": "^3.8.1",
    "reflect-metadata": "^0.2.2",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.1.0",
    "vitest": "^4.0.18"
  }
}
