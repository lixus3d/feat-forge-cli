{
  "name": "feat-forge",
  "version": "0.1.0",
  "description": "Feature-first CLI workflow tool",
  "license": "AGPL-3.0-only",
  "bin": {
    "forge": "dist/cli.js"
  },
  "main": "dist/cli.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && cp -r src/templates dist/",
