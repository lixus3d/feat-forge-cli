    "format:check": "prettier --check ."
  },
  "dependencies": {
    "commander": "^12.1.0",
    "execa": "^9.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "prettier": "^3.8.1",
    "typescript": "^5.6.3"
  }
}
